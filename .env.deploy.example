# KAITools production web deployment variables
#
# Usage: copy this file to a secure, untracked location and replace the
# __REQUIRED__ values before running the deployment workflow or equivalent
# commands. Do not commit real SSH keys or production credentials.

# Release identity. Must match VERSION and the Git tag: web-vX.Y.Z.
RELEASE_TAG=web-v__VERSION__

# Public production validation endpoint.
WEB_HEALTH_URL=https://tools.imkai.top/

# GitHub Actions production environment Secrets. These names match the
# currently configured production inventory. Keep the real values in GitHub,
# not in this repository.
DEPLOY_HOST=__REQUIRED__
DEPLOY_USER=__REQUIRED__
DEPLOY_PORT=__REQUIRED__
DEPLOY_SSH_PRIVATE_KEY=__REQUIRED_SECRET__
DEPLOY_SSH_KNOWN_HOSTS=__REQUIRED_SECRET__

# Absolute release directory on the deployment host. Releases are activated
# by the current and previous symbolic links beneath this directory.
WEB_RELEASES_DIR=__REQUIRED_ABSOLUTE_PATH__

# Variables consumed by scripts/deploy-web.sh on the deployment host.
# GitHub Actions derives these from the values above; set them only for a
# manual deployment on that host.
KAITOOLS_RELEASES_DIR=${WEB_RELEASES_DIR}
KAITOOLS_RELEASE_ID=${RELEASE_TAG}
KAITOOLS_ARCHIVE=__REQUIRED_REMOTE_ARCHIVE_PATH__

# Desktop update publishing Secrets. KAITOOLS_UPDATE_SIGNING_PRIVATE_KEY is
# the GitHub Secret name; the release job must write it to a protected
# temporary file before passing that path to the desktop build.
KAITOOLS_UPDATE_ROOT=__REQUIRED_ABSOLUTE_PATH__
KAITOOLS_UPDATE_SIGNING_PRIVATE_KEY=__REQUIRED_SECRET__

# Frontend build configuration. The application accepts only this production
# origin outside development, and appends /api internally.
VITE_KAITOOLS_API_URL=https://tools.imkai.top
VITE_KAITOOLS_ENABLE_SERVICE_CONFIGURATION=false
